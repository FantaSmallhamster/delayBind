{
  "experiment_id": "2wiki-v5-query-graph-ablation",
  "input": "data/2wiki/dev.json",
  "output_dir": "results/2wiki-v5-query-graph-ablation",
  "dataset_id": "2wiki",
  "sample_start": 0,
  "sample_count": 16,
  "seed": 4,
  "methods": [
    "v5_oracle",
    "v5_oracle_flat",
    "v5_oracle_no_defer",
    "v5_oracle_flat_no_defer"
  ],
  "orders": ["original", "reverse"],
  "compile_oracle": true,
  "max_concurrency": 1,
  "resume": true,
  "retry_errors": true,
  "fail_fast": false,
  "api": {
    "temperature": 0.0,
    "model_seed": 4,
    "enable_thinking": false,
    "max_output_tokens": 2048,
    "api_max_retries": 2,
    "timeout_seconds": 120
  },
  "runner": {
    "chunk_size": 80,
    "min_streaming_windows": 2,
    "query_graph_mode": "open",
    "require_source_span": true,
    "answer_mode": "evidence",
    "max_windows": 100000,
    "max_verify_candidates": 20,
    "max_plan_retries": 1,
    "max_model_calls": 80,
    "snapshot_every_windows": 1,
    "verify_committed": true,
    "max_graph_claims": 128,
    "defer_unbound": true,
    "max_verify_expansions": 1,
    "verify_expansion_limit": 32,
    "require_evidence_sources": true
  }
}
