{
  "input": "data/2wiki/dev.jsonl",
  "sample_index": 0,
  "output": "results/v52_raw_first_smoke.json",
  "db": "runs/v52_raw_first_smoke.sqlite",
  "protocol_version": "v5.2",
  "plan_format": "subqueries",
  "window_mode": "sentence",
  "tokenizer_encoding": "cl100k_base",
  "order": "reverse",
  "seed": 4,
  "chunk_size": 5000,
  "answer_format": "boxed",
  "candidate_batch_size": 16,
  "memory_token_budget": 8192,
  "max_recall_candidates": 1000,
  "max_review_input_tokens": 32768,
  "max_answer_input_tokens": 32768,
  "max_input_tokens": 32768,
  "max_context_tokens": 65536,
  "max_output_tokens": 4096,
  "max_memory_rounds_per_window": 128,
  "max_context_expansions": 8,
  "source_context_before": 1,
  "source_context_after": 1,
  "answer_reserve_calls": 1,
  "answer_reserve_tokens": 512,
  "max_model_calls": 1000,
  "enable_defer_callback": true,
  "defer_unbound": true
}
